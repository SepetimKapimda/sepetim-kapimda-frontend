# Django backend'in kök adresi (bkz. src/lib/apiConfig.ts). Tarayıcıda da
# okunabilmesi için Next.js kuralı gereği `NEXT_PUBLIC_` önekini taşımak
# zorunda — API anahtarı/sır İÇERMEZ, sadece bir URL'dir.
#
# Yerel geliştirmede belirtilmezse kod "http://127.0.0.1:8000" varsayılanını
# kullanır (bilinçli olarak "localhost" değil — bkz. apiConfig.ts'teki not).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Canlı site adresi (bkz. src/lib/seo.ts) — sitemap.ts, robots.ts ve
# layout.tsx'teki metadata bunu okur. Belirtilmezse "https://sepetimkapimda.com"
# varsayılanı kullanılır; sadece farklı bir domain/önizleme ortamında ezmek
# isterseniz tanımlayın.
NEXT_PUBLIC_SITE_URL=https://sepetimkapimda.com

# Google Analytics 4 ölçüm kimliği (ör. G-XXXXXXXXXX). Boş bırakılırsa
# layout.tsx GoogleAnalytics bileşenini hiç render etmez (bkz. not aşağıda).
NEXT_PUBLIC_GA_ID=
